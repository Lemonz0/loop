{
  "name": "liquid-glass-server",
  "version": "1.0.0",
  "description": "High-performance real-time messaging hub, media streaming, and WebRTC signaling server for Liquid Glass iOS app",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "start:local": "node --env-file=.env dist/server.js"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0"
  }
}
