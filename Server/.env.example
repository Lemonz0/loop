# Required only on first startup; supply a random secret (24-256 characters).
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Do not commit or log the generated value.
INVITE_KEY=
PORT=8080
HOST=127.0.0.1
# Optional Spotify profile / listening integration. Register this exact HTTPS URI in Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
# Private 32-byte encryption key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SPOTIFY_TOKEN_KEY=
